# Copy to .env and adjust if the default ports are taken.

# Host port for the container (nginx serves the built SPA on 8080 inside).
PORT=8080

# --- Optional accounts backend (off by default) ------------------------------
# false: no login UI, diagrams stay in the browser's localStorage.
# true:  sign-in / guest accounts, plus server-side projects you can switch between.
NMAP_AUTH_ENABLED=false
NMAP_ALLOW_REGISTRATION=true
NMAP_ALLOW_GUEST=true
# Session lifetime in hours (30 days).
NMAP_SESSION_TTL_HOURS=720
# Guest accounts and their projects are deleted after this many hours.
NMAP_GUEST_TTL_HOURS=24
# Largest diagram a project may store, in MB.
NMAP_MAX_PROJECT_MB=16
# Projects per account.
NMAP_MAX_PROJECTS=200
